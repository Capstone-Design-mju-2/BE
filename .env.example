# PostgreSQL is a replaceable local-development default until the RDB ADR is decided.
CATALOG_DB_NAME=catalog
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=catalog-local
CATALOG_DB_PORT=5433

ORDER_DB_NAME=orders
ORDER_DB_USER=orders
ORDER_DB_PASSWORD=orders-local
ORDER_DB_PORT=5434

REDIS_PORT=6379
# Only for the sync experiment with Debezium (ADR-132): docker compose up -d kafka connect
KAFKA_PORT=9092
CONNECT_PORT=8083

CATALOG_SERVICE_HOST=127.0.0.1
CATALOG_SERVICE_PORT=8081
ORDER_SERVICE_HOST=127.0.0.1
ORDER_SERVICE_PORT=8082
AGENT_SERVICE_HOST=127.0.0.1
AGENT_SERVICE_PORT=8000

CATALOG_SERVICE_URL=http://127.0.0.1:8081
ORDER_SERVICE_URL=http://127.0.0.1:8082

# Stage 1C LLM (ADR-91): any OpenAI-compatible API. Leave LLM_API_KEY empty to answer with the 1B rules.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
# Limit for all LLM calls of one chat together, not for each call; past it the chat answers with the 1B rules.
LLM_TIMEOUT_SECONDS=60
# Fallback (ADR-129): when one call of the LLM above takes longer than LLM_FALLBACK_AFTER_SECONDS or gets 429 or 5xx,
# the chat starts over on this one within the same limit. Leave the model or key empty for no fallback.
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_AFTER_SECONDS=12

# What search-mcp searches (ADR-102): catalog = review text in the catalog DB, opensearch = review vectors.
SEARCH_BACKEND=catalog
OPENSEARCH_URL=http://127.0.0.1:9200
