# Copy to deploy/.env on the server. Never commit the copy.
CATALOG_DB_PASSWORD=
ORDER_DB_PASSWORD=

LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
# Fallback LLM (ADR-129). Leave the model or key empty for none.
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# What the chat searches: opensearch for review meaning (ADR-130), catalog for words in the DB.
SEARCH_BACKEND=opensearch

# The team login Caddy asks for. Make the hash with
#   docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext '<password>'
# and keep the single quotes: the hash contains $ signs.
BASIC_AUTH_USER=team
BASIC_AUTH_HASH=''

# The name Caddy serves and gets a certificate for. On the server it is the public IP
# with dashes instead of dots plus .sslip.io (ADR-126). localhost uses Caddy's own CA.
SITE_ADDRESS=localhost

# Ports Caddy listens on.
HTTP_PORT=80
HTTPS_PORT=443

# Tracing (ADR-182), off unless both lines are set: the first starts Jaeger, the second makes the agent and its
# MCP servers send spans to it. Look at them through `ssh -L 16686:127.0.0.1:16686 <server>`.
# COMPOSE_PROFILES=tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
