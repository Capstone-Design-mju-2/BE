# Copy to deploy/.env on the server. Never commit the copy.
CATALOG_DB_PASSWORD=
ORDER_DB_PASSWORD=

LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=

# The team login Caddy asks for. Make the hash with
#   docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext '<password>'
# and keep the single quotes: the hash contains $ signs.
BASIC_AUTH_USER=team
BASIC_AUTH_HASH=''

# Port Caddy listens on.
HTTP_PORT=80
